                }
                
                // Hash password and security answer
                const hashedPassword = hashPassword(userData.password);
                const hashedSecurityAnswer = hashPassword(userData.securityAnswer);
                
                // Create new user
                const { data, error } = await supabase
                    .from('users')
                    .insert({
                        employee_id: userData.employeeId,
                        password_hash: hashedPassword,
                        email: userData.email,
                        full_name: userData.fullName,
                        phone: userData.phone || '',
                        department: userData.department || '',
                        position: userData.position || '',
                        role: userData.position?.toLowerCase() === 'admin' ? 'admin' : 'user',
                        security_question: userData.securityQuestion,
                        security_answer_hash: hashedSecurityAnswer
                    })
                    .select()
                    .single();
                
                if (error) throw error;
                
                showToast('Registration successful! You can now login.', 'success');
                
                // Switch to login tab
                switchLoginTab('login');
                document.getElementById('loginEmployeeId').value = userData.employeeId;
                document.getElementById('loginPassword').value = userData.password;
                
            } catch (error) {
                showToast('Registration failed: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }

