        async function loadCourses() {
            if (!AppState.session) return;
            
            showLoading('Loading courses...');
            
            try {
                // First get user's course progress
                const { data: userProgress, error: progressError } = await supabase
                    .from('user_course_progress')
                    .select('*')
                    .eq('user_id', AppState.currentUser.id);
                
                if (progressError && progressError.code !== 'PGRST116') { // PGRST116 = no rows returned
                    console.error('Error loading progress:', progressError);
                }
                
                // Get all courses
                const { data: courses, error: coursesError } = await supabase
                    .from('courses')
                    .select('*')
                    .eq('status', 'active')
                    .order('created_at', { ascending: false });
                
                hideLoading();
                
                if (coursesError) {
                    showToast('Failed to load courses: ' + coursesError.message, 'error');
                    return;
                }
                
                // Merge progress with courses
                AppState.courses = courses.map(course => {
                    const progress = userProgress?.find(p => p.course_id === course.id);
                    return {
                        id: course.id,
                        title: course.title,
                        description: course.description,
                        category: course.category,
                        duration: course.duration,
                        difficulty: course.difficulty,
                        hasExam: course.has_exam,
                        progress: progress?.progress || 0,
                        status: progress?.status || 'not-started',
                        lastAccessed: progress?.last_accessed,
                        score: progress?.score || 0,
                        files: [], // We'll load files separately
                        examQuestions: course.total_questions || 0
                    };
                });
                
                renderCourses();
                
            } catch (error) {
                hideLoading();
                showToast('Failed to load courses: ' + error.message, 'error');
            }
        }

        async function updateCourseProgress(courseId, progress, status) {
            if (!AppState.session) return;
            
            try {
                // Check if progress record exists
                const { data: existingProgress, error: checkError } = await supabase
                    .from('user_course_progress')
                    .select('*')
                    .eq('user_id', AppState.currentUser.id)
                    .eq('course_id', courseId)
                    .single();
                
                let result;
                
                if (existingProgress) {
                    // Update existing progress
                    result = await supabase
                        .from('user_course_progress')
                        .update({
                            progress: progress,
                            status: status,
                            last_accessed: new Date().toISOString(),
                            updated_at: new Date().toISOString()
                        })
                        .eq('id', existingProgress.id);
                } else {
                    // Create new progress record
                    result = await supabase
                        .from('user_course_progress')
                        .insert([{
                            user_id: AppState.currentUser.id,
                            course_id: courseId,
                            progress: progress,
                            status: status,
                            last_accessed: new Date().toISOString(),
                            created_at: new Date().toISOString(),
                            updated_at: new Date().toISOString()
                        }]);
                }
                
                if (result.error) {
                    showToast('Failed to update progress: ' + result.error.message, 'error');
                    return;
                }
                
                showToast('Progress updated', 'success');
                loadCourses();
                
                if (AppState.currentPage === 'dashboard') {
                    loadDashboard();
                }
                if (AppState.currentPage === 'progress') {
                    loadProgress();
                }
                
            } catch (error) {
                showToast('Failed to update progress: ' + error.message, 'error');
            }
        }

