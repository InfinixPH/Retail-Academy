        // INTERFACE FUNCTIONS (SAME AS BEFORE)
        // ============================================
        function showLoginInterface() {
            document.getElementById('mainHeader').style.display = 'none';
            document.getElementById('appContainer').style.display = 'none';
            document.getElementById('mainFooter').style.display = 'none';
            document.getElementById('loginModal').style.display = 'block';
        }

        function showMainInterface() {
            document.getElementById('loginModal').style.display = 'none';
            document.getElementById('mainHeader').style.display = 'block';
            document.getElementById('appContainer').style.display = 'block';
            document.getElementById('mainFooter').style.display = 'block';
            
            updateUserUI();
            
            if (AppState.isAdmin || AppState.isSuperAdmin) {
                document.getElementById('adminNavItem').style.display = 'flex';
                document.getElementById('mobileAdminNavItem').style.display = 'block';
                document.getElementById('adminCourseButton').style.display = 'inline-flex';
                document.getElementById('adminCertificateButton').style.display = 'inline-flex';
            }
            
            loadDashboard();
        }

        function updateUserUI() {
            if (!AppState.currentUser) return;
            
            document.getElementById('dashboardUserName').textContent = AppState.currentUser.name;
            document.getElementById('dropdownUserName').textContent = AppState.currentUser.name;
            document.getElementById('dropdownUserRole').textContent = AppState.currentUser.role.toUpperCase();
            
            const initials = AppState.currentUser.name.split(' ')
                .map(n => n[0])
                .join('')
                .toUpperCase()
                .substring(0, 2);
            document.getElementById('userAvatar').textContent = initials;
        }

        // ============================================
