                            <input type="text" class="form-control" id="profilePosition" value="${profile.position || ''}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Role</label>
                        <input type="text" class="form-control" value="${profile.role || ''}" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Join Date</label>
                        <input type="text" class="form-control" value="${new Date(profile.join_date).toLocaleDateString() || ''}" readonly>
                    </div>
