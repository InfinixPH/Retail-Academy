        // ADMIN FUNCTIONS - SUPABASE VERSION
        // ============================================
        async function loadAdminDashboard() {
            if (!AppState.session || (!AppState.isAdmin && !AppState.isSuperAdmin)) return;
            
            showLoading('Loading admin dashboard...');
            
            try {
                // Get total users
                const { count: totalUsers, error: usersError } = await supabase
                    .from('users')
                    .select('*', { count: 'exact', head: true });
                
                // Get active users
                const { count: activeUsers, error: activeError } = await supabase
                    .from('users')
                    .select('*', { count: 'exact', head: true })
                    .eq('status', 'active');
                
                // Get total courses
                const { count: totalCourses, error: coursesError } = await supabase
                    .from('courses')
                    .select('*', { count: 'exact', head: true });
                
                // Get total certificates
                const { count: totalCertificates, error: certError } = await supabase
                    .from('certificates')
                    .select('*', { count: 'exact', head: true });
                
                hideLoading();
                
                const stats = {
                    users: {
                        total: totalUsers || 0,
                        active: activeUsers || 0
                    },
                    courses: {
                        total: totalCourses || 0
                    },
                    certificates: {
                        total: totalCertificates || 0
                    }
                };
                
                document.getElementById('adminTotalUsers').textContent = stats.users.total;
                document.getElementById('adminActiveUsers').textContent = stats.users.active;
                document.getElementById('adminTotalCourses').textContent = stats.courses.total;
                document.getElementById('adminCertificates').textContent = stats.certificates.total;
                
                loadAllUsers();
                loadAdminCourses();
                
            } catch (error) {
                hideLoading();
                showToast('Failed to load admin dashboard: ' + error.message, 'error');
            }
        }

        async function loadAllUsers() {
            if (!AppState.session || (!AppState.isAdmin && !AppState.isSuperAdmin)) return;
            
            try {
                const { data: users, error } = await supabase
                    .from('users')
                    .select('*')
                    .order('created_at', { ascending: false });
                
                if (error) {
                    console.error('Failed to load users:', error);
                    return;
                }
                
                renderUsersTable(users || []);
                
            } catch (error) {
                console.error('Failed to load users:', error);
            }
        }

