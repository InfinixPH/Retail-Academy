        async function loadDashboard() {
            if (!AppState.session) return;
            
            showLoading('Loading dashboard...');
            
            try {
                // Get user progress summary
                const { data: progress, error: progressError } = await supabase
                    .from('user_course_progress')
                    .select('progress, status, score')
                    .eq('user_id', AppState.currentUser.id);
                
                if (progressError && progressError.code !== 'PGRST116') {
                    console.error('Error loading progress:', progressError);
                }
                
                // Get certificates count
                const { data: certificates, error: certError } = await supabase
                    .from('certificates')
                    .select('id')
                    .eq('user_id', AppState.currentUser.id)
                    .eq('status', 'active');
                
                // Get total courses
                const { data: totalCourses, error: coursesError } = await supabase
                    .from('courses')
                    .select('id', { count: 'exact' })
                    .eq('status', 'active');
                
                hideLoading();
                
                // Calculate stats
                const completedCourses = progress?.filter(p => p.status === 'completed').length || 0;
                const inProgressCourses = progress?.filter(p => p.status === 'in-progress').length || 0;
                const averageScore = progress?.filter(p => p.score > 0).length > 0 
                    ? Math.round(progress.filter(p => p.score > 0).reduce((sum, p) => sum + p.score, 0) / progress.filter(p => p.score > 0).length)
                    : 0;
                
                const stats = {
                    completedCourses: completedCourses,
                    averageScore: averageScore,
                    certificates: certificates?.length || 0,
                    totalCourses: totalCourses?.length || 0,
                    inProgressCourses: inProgressCourses
                };
                
                // Update UI
                document.getElementById('completedCourses').textContent = stats.completedCourses;
                document.getElementById('averageScore').textContent = stats.averageScore + '%';
                document.getElementById('certificatesCount').textContent = stats.certificates;
                
                document.getElementById('progressCompleted').textContent = stats.completedCourses;
                document.getElementById('progressScore').textContent = stats.averageScore + '%';
                document.getElementById('progressTotal').textContent = stats.totalCourses;
                document.getElementById('progressInProgress').textContent = stats.inProgressCourses;
                
                // Learning hours (simulated - you should track this properly)
                const learningHours = Math.round((completedCourses * 2) + (inProgressCourses * 1));
                document.getElementById('learningHours').textContent = learningHours + 'h';
                
                setupProgressChart(stats);
                loadContinueLearning();
                loadNotifications();
                
            } catch (error) {
                hideLoading();
                showToast('Failed to load dashboard: ' + error.message, 'error');
            }
        }

