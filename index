        async function loadCourses() {
            if (!AppState.currentUser) return;
            
            showLoading('Loading courses...');
            
            try {
                // Get all courses
                const { data: courses, error } = await supabase
                    .from('courses')
                    .select('*')
                    .order('created_at', { ascending: false });
                
                if (error) throw error;
                
                // Get user progress for these courses
                const { data: progress, error: progressError } = await supabase
                    .from('user_progress')
                    .select('*')
                    .eq('user_id', AppState.currentUser.id);
                
                if (progressError) throw progressError;
                
                // Combine course data with progress
                const coursesWithProgress = courses.map(course => {
                    const userProgress = progress?.find(p => p.course_id === course.id) || {
                        progress: 0,
                        status: 'not-started',
                        score: 0
                    };
                    
                    return {
                        ...course,
                        progress: userProgress.progress,
                        status: userProgress.status,
                        score: userProgress.score,
                        course_id: course.course_code // Use course_code for display
                    };
                });
                
                AppState.courses = coursesWithProgress;
                renderCourses();
                
            } catch (error) {
                showToast('Failed to load courses: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
