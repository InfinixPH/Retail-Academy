        async function handleLogin() {
            const employeeId = document.getElementById('loginEmployeeId').value.trim();
            const password = document.getElementById('loginPassword').value;
            
            if (!employeeId || !password) {
                showToast('Please enter Employee ID and password', 'error');
                return;
            }
            
            showLoading('Signing in...');
            
            try {
                // First get user by employee_id
                const { data: users, error: userError } = await supabase
                    .from('users')
                    .select('*')
                    .eq('employee_id', employeeId)
                    .single();
                
                if (userError || !users) {
                    hideLoading();
                    showToast('Invalid Employee ID or password', 'error');
                    return;
                }
                
                // Verify password (in real app, you should hash passwords)
                // For now, we'll use direct comparison (NOT SECURE - you should implement proper hashing)
                if (users.password !== password) {
                    hideLoading();
                    showToast('Invalid Employee ID or password', 'error');
                    return;
                }
                
                // Check if user is active
                if (users.status !== 'active') {
                    hideLoading();
                    showToast('Account is not active. Please contact administrator.', 'error');
                    return;
                }
                
                // Create session data
                AppState.currentUser = {
                    id: users.id,
                    employee_id: users.employee_id,
                    name: users.full_name,
                    email: users.email,
                    role: users.role,
                    department: users.department,
                    position: users.position
                };
                
                AppState.isAdmin = users.role === 'admin' || users.role === 'super_admin';
                AppState.isSuperAdmin = users.role === 'super_admin';
                
                // Create session object
                AppState.session = {
                    userId: users.id,
                    employeeId: users.employee_id,
                    role: users.role,
                    timestamp: new Date().toISOString()
                };
                
                // Save session to localStorage
                localStorage.setItem('infinixSession', JSON.stringify(AppState.session));
                
                // Update last login
                await supabase
                    .from('users')
                    .update({ last_login: new Date().toISOString() })
                    .eq('id', users.id);
                
                hideLoading();
                showToast('Login successful! Welcome ' + users.full_name, 'success');
                
                // Show main interface
                setTimeout(() => {
                    showMainInterface();
                }, 500);
                
            } catch (error) {
                hideLoading();
                console.error('Login error:', error);
                showToast('Login failed: ' + error.message, 'error');
            }
        }

        async function validateSession() {
            if (!AppState.session) {
                console.log('No session to validate');
                showLoginInterface();
                return;
            }
            
            showLoading('Checking session...');
            
            try {
                // Check if user still exists and is active
                const { data: user, error } = await supabase
                    .from('users')
                    .select('id, full_name, email, role, status')
                    .eq('id', AppState.session.userId)
                    .single();
                
                hideLoading();
                
                if (error || !user || user.status !== 'active') {
                    localStorage.removeItem('infinixSession');
                    AppState.session = null;
                    showToast('Session expired. Please login again.', 'warning');
                    showLoginInterface();
                    return;
                }
                
                AppState.currentUser = {
                    id: user.id,
                    name: user.full_name,
                    email: user.email,
                    role: user.role
                };
                
                AppState.isAdmin = user.role === 'admin' || user.role === 'super_admin';
                AppState.isSuperAdmin = user.role === 'super_admin';
                
                showMainInterface();
                
            } catch (error) {
                hideLoading();
                console.error('Session validation error:', error);
                localStorage.removeItem('infinixSession');
                AppState.session = null;
                showLoginInterface();
            }
        }

        async function handleRegistration() {
            const employeeId = document.getElementById('regEmployeeId').value.trim();
            const fullName = document.getElementById('regFullName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const phone = document.getElementById('regPhone').value.trim();
            const department = document.getElementById('regDepartment').value;
            const position = document.getElementById('regPosition').value;
            const securityQuestion = document.getElementById('regSecurityQuestion').value;
            const securityAnswer = document.getElementById('regSecurityAnswer').value.trim();
            const password = document.getElementById('regPassword').value;
            const confirmPassword = document.getElementById('regConfirmPassword').value;
            const terms = document.getElementById('regTerms').checked;
            
            if (!employeeId || !fullName || !email || !department || !position || 
                !securityQuestion || !securityAnswer || !password) {
                showToast('Please fill all required fields', 'error');
                return;
            }
            
            if (password.length < 6) {
                showToast('Password must be at least 6 characters', 'error');
                return;
            }
            
            if (password !== confirmPassword) {
                showToast('Passwords do not match', 'error');
                return;
            }
            
            if (!terms) {
                showToast('You must accept the terms and conditions', 'error');
                return;
            }
            
            showLoading('Creating account...');
            
            try {
                // Check if employee ID already exists
                const { data: existingUser, error: checkError } = await supabase
                    .from('users')
                    .select('employee_id')
                    .eq('employee_id', employeeId)
                    .single();
                
                if (existingUser) {
                    hideLoading();
                    showToast('Employee ID already exists', 'error');
                    return;
                }
                
                // Check if email already exists
                const { data: existingEmail, error: emailError } = await supabase
                    .from('users')
                    .select('email')
                    .eq('email', email)
                    .single();
                
                if (existingEmail) {
                    hideLoading();
                    showToast('Email already registered', 'error');
                    return;
                }
                
                // Insert new user
                const { data, error } = await supabase
                    .from('users')
                    .insert([{
                        employee_id: employeeId,
                        full_name: fullName,
                        email: email,
                        phone: phone,
                        department: department,
                        position: position,
                        password: password, // In production, hash this password!
                        security_question: securityQuestion,
                        security_answer: securityAnswer,
                        role: 'user',
                        status: 'active',
                        join_date: new Date().toISOString(),
                        created_at: new Date().toISOString()
                    }])
                    .select();
                
                hideLoading();
                
                if (error) {
                    showToast('Registration failed: ' + error.message, 'error');
                    return;
                }
                
                showToast('Registration successful! You can now login.', 'success');
                switchLoginTab('login');
                document.getElementById('loginEmployeeId').value = employeeId;
                document.getElementById('loginPassword').value = password;
                
            } catch (error) {
                hideLoading();
                showToast('Registration failed: ' + error.message, 'error');
            }
        }

