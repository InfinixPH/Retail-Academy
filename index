        async function updateCourseProgress(courseId, progress, status) {
            if (!AppState.currentUser) return;
            
            try {
                // Check if progress already exists
                const { data: existingProgress, error: checkError } = await supabase
                    .from('user_progress')
                    .select('*')
                    .eq('user_id', AppState.currentUser.id)
                    .eq('course_id', courseId)
                    .single();
                
                let result;
                
                if (checkError || !existingProgress) {
                    // Create new progress record
                    result = await supabase
                        .from('user_progress')
                        .insert({
                            user_id: AppState.currentUser.id,
                            course_id: courseId,
                            progress: progress,
                            status: status,
                            score: status === 'completed' ? 100 : 0,
                            completed_at: status === 'completed' ? new Date().toISOString() : null,
                            last_accessed: new Date().toISOString()
                        });
                } else {
                    // Update existing progress
                    result = await supabase
                        .from('user_progress')
                        .update({
                            progress: progress,
                            status: status,
                            score: status === 'completed' ? 100 : existingProgress.score,
                            completed_at: status === 'completed' ? new Date().toISOString() : existingProgress.completed_at,
                            last_accessed: new Date().toISOString()
                        })
                        .eq('id', existingProgress.id);
                }
                
                if (result.error) throw result.error;
                
                showToast('Progress updated successfully', 'success');
                
                // Reload data
                loadCourses();
                if (AppState.currentPage === 'dashboard') loadDashboard();
                if (AppState.currentPage === 'progress') loadProgress();
                
            } catch (error) {
                showToast('Failed to update progress: ' + error.message, 'error');
